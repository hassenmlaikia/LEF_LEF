    match /subscriptions/{uid}{allow read:if self(uid)||hasCapability('manageSubscriptions');allow create,update:if hasCapability('manageSubscriptions')&&request.resource.data.uid==uid&&request.resource.data.plan in ['free','plus','business'];allow delete:if owner();}
    match /stories/{storyId}{allow read:if signedIn()&&resource.data.expiresAt>request.time;allow create:if signedIn()&&request.resource.data.authorId==request.auth.uid&&request.resource.data.text is string&&request.resource.data.text.size()<=500&&request.resource.data.expiresAt>request.time&&request.resource.data.expiresAt<=request.time+duration.value(24,'h')&&(request.resource.data.text.size()>0||request.resource.data.mediaUrl is string)&&(!('mediaType' in request.resource.data)||request.resource.data.mediaType in ['image','video']);allow update:if signedIn()&&((resource.data.authorId==request.auth.uid&&request.resource.data.authorId==resource.data.authorId&&request.resource.data.text is string&&request.resource.data.text.size()<=500&&request.resource.data.expiresAt==resource.data.expiresAt&&(request.resource.data.text.size()>0||request.resource.data.mediaUrl is string)&&(!('mediaType' in request.resource.data)||request.resource.data.mediaType in ['image','video'])&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','mediaUrl','mediaType','expiresAt','updatedAt']))||hasCapability('moderateContent'));allow delete:if signedIn()&&(resource.data.authorId==request.auth.uid||hasCapability('moderateContent'));}
    match /stories/{storyId}/viewers/{uid}{allow read:if signedIn()&&(request.auth.uid==uid||get(/databases/$(database)/documents/stories/$(storyId)).data.authorId==request.auth.uid||hasCapability('moderateContent'));allow create,update:if signedIn()&&request.auth.uid==uid&&request.resource.data.uid==uid&&exists(/databases/$(database)/documents/stories/$(storyId))&&get(/databases/$(database)/documents/stories/$(storyId)).data.expiresAt>request.time&&(get(/databases/$(database)/documents/stories/$(storyId)).data.authorId==request.auth.uid||notBlocked(request.auth.uid,get(/databases/$(database)/documents/stories/$(storyId)).data.authorId));allow delete:if signedIn()&&request.auth.uid==uid||hasCapability('moderateContent');}
    match /stories/{storyId}/reactions/{uid}{allow read:if signedIn();allow create,update:if signedIn()&&request.auth.uid==uid&&request.resource.data.uid==uid&&request.resource.data.reaction=='❤️'&&exists(/databases/$(database)/documents/stories/$(storyId))&&get(/databases/$(database)/documents/stories/$(storyId)).data.expiresAt>request.time&&(get(/databases/$(database)/documents/stories/$(storyId)).data.authorId==request.auth.uid||notBlocked(request.auth.uid,get(/databases/$(database)/documents/stories/$(storyId)).data.authorId));allow delete:if signedIn()&&request.auth.uid==uid||hasCapability('moderateContent');}

    match /companies/{companyId}{
      allow read:if signedIn();
      allow create:if signedIn()&&request.resource.data.ownerId==request.auth.uid&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='partner'&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.providerVerified==true;
      allow update,delete:if signedIn()&&((resource.data.ownerId==request.auth.uid&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='partner')||hasCapability('manageServices'));
      match /products/{productId}{allow read:if signedIn();allow create:if signedIn()&&(get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId==request.auth.uid||hasCapability('manageServices'))&&request.resource.data.name is string&&request.resource.data.price is number&&request.resource.data.price>=0&&request.resource.data.stock is number&&request.resource.data.stock>=0;allow update:if signedIn()&&((get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId==request.auth.uid||hasCapability('manageServices'))||(get(/databases/$(database)/documents/employeeProfiles/$(request.auth.uid)).data.companyId==companyId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','updatedAt'])&&request.resource.data.stock is number&&request.resource.data.stock>=0));allow delete:if signedIn()&&(get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId==request.auth.uid||hasCapability('manageServices'));}
      function companyOwnerOrServiceManager(){return signedIn()&&(get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId==request.auth.uid||hasCapability('manageServices'));}
      match /branches/{branchId}{allow read:if signedIn();allow create:if companyOwnerOrServiceManager()&&request.resource.data.name is string&&request.resource.data.name.size()>0&&request.resource.data.name.size()<=120&&request.resource.data.address is string&&request.resource.data.address.size()>0&&request.resource.data.address.size()<=300&&request.resource.data.openingHours is map&&request.resource.data.serviceAreas is list;allow update:if companyOwnerOrServiceManager()&&request.resource.data.name is string&&request.resource.data.address is string&&request.resource.data.openingHours is map&&request.resource.data.serviceAreas is list;allow delete:if companyOwnerOrServiceManager();}
      match /appointments/{appointmentId}{allow read:if signedIn()&&(resource.data.userId==request.auth.uid||companyOwnerOrServiceManager());allow create:if signedIn()&&request.resource.data.userId==request.auth.uid&&request.resource.data.service is string&&request.resource.data.service.size()>0&&request.resource.data.startsAt>request.time&&request.resource.data.status=='requested';allow update:if companyOwnerOrServiceManager()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])&&request.resource.data.status in ['confirmed','rejected','completed','cancelled','waitlisted'];allow delete:if false;}
      match /waitlist/{entryId}{allow read:if signedIn()&&(resource.data.userId==request.auth.uid||companyOwnerOrServiceManager());allow create:if signedIn()&&request.resource.data.userId==request.auth.uid&&request.resource.data.service is string&&request.resource.data.status=='waiting';allow update:if companyOwnerOrServiceManager()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])&&request.resource.data.status in ['waiting','notified','served','cancelled'];allow delete:if signedIn()&&resource.data.userId==request.auth.uid;}
      // PASS135 company operation records: company owner/service manager controls workflow; user submissions are scoped.
      match /operations/{kind}/items/{itemId}{
        allow read: if signedIn()&&(companyOwnerOrServiceManager()||resource.data.userId==request.auth.uid);
        allow create: if signedIn()&&request.resource.data.createdBy==request.auth.uid&&companyOwnerOrServiceManager()&&request.resource.data.keys().hasAny(['status','createdAt','updatedAt']);
        allow update: if companyOwnerOrServiceManager()&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewedBy','reviewedAt','updatedAt','details','assignedTo','permissions','enabled','open','close','closed','date','name','price','stock','sku','photoUrl','description','serviceArea','startAt','endAt','capacity','severity','resolution']);
        allow delete: if companyOwnerOrServiceManager()&&kind in ['serviceCatalog','availability','staffAssignments','staffPermissions'];
      }
      match /operations/{kind}/items/{itemId} { allow create: if signedIn()&&kind in ['reviews','complaints']&&request.resource.data.userId==request.auth.uid&&request.resource.data.status in ['pending','open']; }
      match /operations/audit/entries/{entryId}{allow read:if companyOwnerOrServiceManager();allow create:if companyOwnerOrServiceManager()&&request.resource.data.actorId==request.auth.uid&&request.resource.data.action is string;allow update,delete:if false;}
    }
    match /employeeProfiles/{uid}{
      allow read:if self(uid)||hasCapability('manageUsers');
      allow create,update:if self(uid)&&request.resource.data.uid==uid&&request.resource.data.companyId is string&&request.resource.data.employeeId is string&&existsAfter(/databases/$(database)/documents/employees/$(request.resource.data.employeeId))&&getAfter(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.userId==uid&&getAfter(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.status=='active'&&getAfter(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.companyId==request.resource.data.companyId;
      allow delete:if self(uid)||hasCapability('manageUsers');
    }
    match /employees/{employeeId}{
      allow read:if signedIn()&&(resource.data.userId==request.auth.uid||resource.data.createdBy==request.auth.uid||hasCapability('manageUsers')||resource.data.email==request.auth.token.email||(resource.data.companyId is string&&get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.ownerId==request.auth.uid));
      allow create:if signedIn()&&request.resource.data.createdBy==request.auth.uid&&request.resource.data.companyId is string&&get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId==request.auth.uid&&request.resource.data.email is string&&request.resource.data.email.size()>3&&request.resource.data.status=='pending';
      allow update:if signedIn()&&(
        (resource.data.userId==request.auth.uid&&resource.data.status=='active'&&request.resource.data.userId==resource.data.userId&&request.resource.data.companyId==resource.data.companyId&&request.resource.data.createdBy==resource.data.createdBy&&request.resource.data.email==resource.data.email&&request.resource.data.status==resource.data.status&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt']))
        ||
        (resource.data.status=='pending'&&resource.data.email==request.auth.token.email&&request.resource.data.userId==request.auth.uid&&request.resource.data.status in ['active','rejected']&&request.resource.data.companyId==resource.data.companyId&&request.resource.data.createdBy==resource.data.createdBy&&request.resource.data.email==resource.data.email&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId','status','activatedAt','rejectedAt']))
        ||
        (resource.data.createdBy==request.auth.uid&&get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.ownerId==request.auth.uid&&request.resource.data.createdBy==resource.data.createdBy&&request.resource.data.companyId==resource.data.companyId&&request.resource.data.email==resource.data.email&&request.resource.data.userId==resource.data.userId&&request.resource.data.status in ['pending','active','rejected']&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','status','updatedAt']))
        ||hasCapability('manageUsers')
      );
      allow delete:if signedIn()&&(resource.data.createdBy==request.auth.uid||hasCapability('manageUsers'));
    }
    // Customer cancellation events are append-only and linked to a cancelled ride.
    // Only the customer may create an event for their own cancelled ride; managers review it.
    match /customerCancellationEvents/{eventId}{
      allow read:if hasCapability('manageRides');
      allow create:if signedIn()&&request.resource.data.clientId==request.auth.uid&&request.resource.data.rideId is string&&exists(/databases/$(database)/documents/rides/$(request.resource.data.rideId))&&get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.clientId==request.auth.uid&&get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.status=='cancelled'&&get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.cancelledBy==request.auth.uid&&request.resource.data.reason is string&&request.resource.data.reason.size()>0&&request.resource.data.reason.size()<=300&&request.resource.data.reviewStatus=='pending';
      allow update,delete:if hasCapability('manageRides')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus','reviewedBy','reviewedAt','reviewNote'])&&request.resource.data.reviewStatus in ['pending','reviewed','dismissed'];
    }
    // Provider cancellation events are append-only and linked to the real
    // cancelled ride. Only the provider who cancelled it may create the event;
    // only authorized ride managers may review/read the collection.
    match /providerCancellationEvents/{eventId}{
      allow read:if hasCapability('manageRides');
      allow create:if signedIn()&&request.resource.data.providerId==request.auth.uid&&request.resource.data.rideId is string&&exists(/databases/$(database)/documents/rides/$(request.resource.data.rideId))&&get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.providerId==request.auth.uid&&get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.status=='cancelled'&&get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.cancelledBy==request.auth.uid&&request.resource.data.reason is string&&request.resource.data.reason.size()>0&&request.resource.data.reason.size()<=300&&request.resource.data.reviewStatus=='pending';
      allow update,delete:if hasCapability('manageRides')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus','reviewedBy','reviewedAt','reviewNote'])&&request.resource.data.reviewStatus in ['pending','reviewed','dismissed','suspension_recommended'];
    }
    // User-owned account deletion request; final deletion requires a trusted scheduled backend job.
    match /accountDeletionRequests/{uid} {
      allow read: if self(uid)||hasCapability('manageUsers');
      allow create: if self(uid)&&get(/databases/$(database)/documents/users/$(uid)).data.role!='owner'&&!exists(/databases/$(database)/documents/accountDeletionRequests/$(uid))&&request.resource.data.userId==uid&&request.resource.data.status=='pending'&&request.resource.data.scheduledFor is timestamp&&request.resource.data.scheduledFor>request.time&&request.resource.data.scheduledFor<=request.time+duration.value(31,'d')&&request.resource.data.policyVersion is string;
      allow update: if self(uid)&&((resource.data.status=='pending'&&request.resource.data.status=='cancelled'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt'])&&resource.data.scheduledFor>request.time)||(resource.data.status=='cancelled'&&request.resource.data.status=='pending'&&get(/databases/$(database)/documents/users/$(uid)).data.role!='owner'&&request.resource.data.userId==uid&&request.resource.data.scheduledFor is timestamp&&request.resource.data.scheduledFor>request.time&&request.resource.data.scheduledFor<=request.time+duration.value(31,'d')&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId','email','status','requestedAt','scheduledFor','policyVersion'])))&&request.resource.data.userId==uid;
      allow delete: if owner();
    }

    // Owner/authorized administration audit trail; append-only.
    match /auditLogs/{logId}{allow read:if hasCapability('manageRoles');allow create:if signedIn()&&request.resource.data.actorId==request.auth.uid&&hasCapability('manageRoles')&&request.resource.data.action is string&&request.resource.data.action.size()>0&&request.resource.data.action.size()<=100;allow update,delete:if false;}

  }
}

