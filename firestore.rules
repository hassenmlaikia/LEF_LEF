rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){return request.auth!=null;}
    function self(uid){return signedIn()&&request.auth.uid==uid;}
    function notBlocked(a,b){return a!=b&&!exists(/databases/$(database)/documents/users/$(a)/blockedUsers/$(b))&&!exists(/databases/$(database)/documents/users/$(b)/blockedUsers/$(a));}
    function owner(){return signedIn()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='owner';}
    function hasCapability(cap){return owner()||(signedIn()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='manager'&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.capabilities is list&&cap in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.capabilities)||(signedIn()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role!='manager'&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.capabilities is list&&cap in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.capabilities);}
    function manager(){return hasCapability('manageUsers');}
    function provider(){let p=get(/databases/$(database)/documents/users/$(request.auth.uid)).data;return hasCapability('manageRides')&&p.role in ['driver','deliveryProvider','partner']&&p.providerVerified==true&&(!('accountSuspended' in p)||p.accountSuspended!=true||('suspendedUntil' in p&&p.suspendedUntil<=request.time))&&(!('providerDocumentsExpiry' in p)||p.providerDocumentsExpiry>request.time)&&(!('documentsExpiryAt' in p)||p.documentsExpiryAt>request.time);}
    function validLat(v){return v is number&&v>=-90&&v<=90;}
    function validLng(v){return v is number&&v>=-180&&v<=180;}
    function defaultBaseFor(kind){return kind=='taxiMoto'?2:kind=='carExpress'?4:kind=='deliveryMoto'?2:kind=='deliveryVan'?4:0;}
    function defaultRateFor(period,kind){return kind in ['taxiMoto','carExpress','deliveryMoto','deliveryVan']?(period=='night'?1.5:1):0;}
    function baseFor(kind){
      let p=get(/databases/$(database)/documents/system/pricing).data;
      return exists(/databases/$(database)/documents/system/pricing)&&('baseFares' in p)&&p.baseFares is map&&p.baseFares.keys().hasAny([kind])?p.baseFares[kind]:defaultBaseFor(kind);
    }
    function rateFor(kind,period){
      let p=get(/databases/$(database)/documents/system/pricing).data;
      let rates=period=='night'?'nightRates':'dayRates';
      return exists(/databases/$(database)/documents/system/pricing)&&rates in p&&p[rates] is map&&p[rates].keys().hasAny([kind])?p[rates][kind]:defaultRateFor(period,kind);
    }
    function negotiableFor(kind){
      let p=get(/databases/$(database)/documents/system/pricing).data;
      return exists(/databases/$(database)/documents/system/pricing)&&('negotiableKinds' in p)&&p.negotiableKinds is list ? kind in p.negotiableKinds : kind in ['deliveryTruck','sos','ambulance','randonnee'];
    }
    function canServe(kind){
      let role=get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return (role=='driver'&&kind in ['taxiMoto','carExpress','sos','ambulance','randonnee']) ||
        (role=='deliveryProvider'&&kind in ['deliveryMoto','deliveryVan','deliveryTruck']) ||
        (role=='partner'&&kind in ['taxiMoto','carExpress','deliveryMoto','deliveryVan','deliveryTruck','sos','ambulance','randonnee']);
    }
    function roleCanServe(role,kind){
      return (role=='driver'&&kind in ['taxiMoto','carExpress','sos','ambulance','randonnee']) ||
        (role=='deliveryProvider'&&kind in ['deliveryMoto','deliveryVan','deliveryTruck']) ||
        (role=='partner'&&kind in ['taxiMoto','carExpress','deliveryMoto','deliveryVan','deliveryTruck','sos','ambulance','randonnee']);
    }
    function qualifiedProvider(uid,kind){
      let p=get(/databases/$(database)/documents/users/$(uid)).data;
      return p.providerVerified==true&&p.providerAvailable==true&&(!('accountSuspended' in p)||p.accountSuspended!=true||('suspendedUntil' in p&&p.suspendedUntil<=request.time))&&(!('providerDocumentsExpiry' in p)||p.providerDocumentsExpiry>request.time)&&(!('documentsExpiryAt' in p)||p.documentsExpiryAt>request.time)&&p.capabilities is list&&'manageRides' in p.capabilities&&roleCanServe(p.role,kind);
    }
    function protectedUser(uid){return get(/databases/$(database)/documents/users/$(uid)).data.role=='owner';}
    function defaultCaps(role){
      return role=='owner'?['manageUsers','manageRoles','manageServices','manageRides','manageSubscriptions','manageNotifications','moderateContent','viewDashboard']:
        role=='manager'?['manageRides']:
        role=='moderator'?['moderateContent']:
        role=='partner'||role=='driver'||role=='deliveryProvider'?['manageRides']:[];
    }

    match /system/{docId}{
      allow create:if (signedIn()&&docId=='bootstrap'&&!exists(/databases/$(database)/documents/system/bootstrap)&&getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='owner'&&getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.uid==request.auth.uid)||(hasCapability('manageServices')&&docId=='pricing'&&request.resource.data.baseFares is map&&request.resource.data.dayRates is map&&request.resource.data.nightRates is map&&request.resource.data.negotiableKinds is list);
      allow read:if signedIn();
      allow update:if (docId=='pricing'&&hasCapability('manageServices'))||owner();
      allow delete:if owner();
    }

    match /system/{docId}/history/{historyId}{allow read:if hasCapability('manageServices');allow create:if hasCapability('manageServices')&&request.resource.data.changedBy==request.auth.uid&&request.resource.data.previous is map&&request.resource.data.next is map;allow update,delete:if false;}

    match /publicProfiles/{uid}{
      allow read:if signedIn()&&(hasCapability('manageUsers')||self(uid)||resource.data.visibility=='public'||(resource.data.visibility=='followers'&&exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid))));
      allow create:if (self(uid)&&request.resource.data.uid==uid&&request.resource.data.displayName is string&&request.resource.data.displayNameLower is string&&(!('visibility' in request.resource.data)||request.resource.data.visibility in ['public','followers','private']))||(hasCapability('manageRoles')&&request.resource.data.uid==uid&&request.resource.data.keys().hasOnly(['uid','role','displayName','displayNameLower','visibility','updatedAt']));
      allow update:if (self(uid)&&request.resource.data.uid==uid&&request.resource.data.displayName is string&&request.resource.data.displayNameLower is string&&(!('visibility' in request.resource.data)||request.resource.data.visibility in ['public','followers','private'])&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','displayName','displayNameLower','role','bio','city','interests','photoUrl','coverUrl','visibility','updatedAt'])||(hasCapability('manageRoles')&&request.resource.data.uid==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','displayName','displayNameLower','visibility','updatedAt']));
      allow delete:if self(uid)||hasCapability('manageUsers');
    }
    match /users/{uid}{
      allow read:if self(uid)||hasCapability('manageUsers');
      allow create:if self(uid)&&((request.resource.data.role=='client'&&request.resource.data.capabilities is list)||(request.resource.data.role=='owner'&&!exists(/databases/$(database)/documents/system/bootstrap)&&request.resource.data.capabilities is list));
      allow update:if
        (self(uid)&&resource.data.role=='client'&&request.resource.data.uid==uid&&request.resource.data.role=='employee'&&request.resource.data.roleSelected==true&&request.resource.data.capabilities is list&&request.resource.data.capabilities.size()==0&&existsAfter(/databases/$(database)/documents/employeeProfiles/$(uid))&&getAfter(/databases/$(database)/documents/employeeProfiles/$(uid)).data.uid==uid&&getAfter(/databases/$(database)/documents/employeeProfiles/$(uid)).data.companyId is string&&existsAfter(/databases/$(database)/documents/employees/$(getAfter(/databases/$(database)/documents/employeeProfiles/$(uid)).data.employeeId))&&getAfter(/databases/$(database)/documents/employees/$(getAfter(/databases/$(database)/documents/employeeProfiles/$(uid)).data.employeeId)).data.userId==uid&&getAfter(/databases/$(database)/documents/employees/$(getAfter(/databases/$(database)/documents/employeeProfiles/$(uid)).data.employeeId)).data.status=='active')
        ||
        (self(uid)&&request.resource.data.uid==resource.data.uid&&request.resource.data.role==resource.data.role&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','displayNameLower','bio','photoUrl','coverUrl','phone','city','interests','profileVisibility','notificationsEnabled','notificationPreferences','privacyPersonalization','language','vehicleType','vehicleModel','vehiclePlate','providerAvailable','providerUpdatedAt','updatedAt'])&&(!('profileVisibility' in request.resource.data)||request.resource.data.profileVisibility in ['public','followers','private'])&&(!('notificationPreferences' in request.resource.data)||(request.resource.data.notificationPreferences is map&&request.resource.data.notificationPreferences.keys().hasOnly(['rides','social','events','pricing','quietHoursEnabled','quietStart','quietEnd'])&&request.resource.data.notificationPreferences.rides is bool&&request.resource.data.notificationPreferences.social is bool&&request.resource.data.notificationPreferences.events is bool&&request.resource.data.notificationPreferences.pricing is bool&&(!('quietHoursEnabled' in request.resource.data.notificationPreferences)||request.resource.data.notificationPreferences.quietHoursEnabled is bool)&&(!('quietStart' in request.resource.data.notificationPreferences)||request.resource.data.notificationPreferences.quietStart.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))&&(!('quietEnd' in request.resource.data.notificationPreferences)||request.resource.data.notificationPreferences.quietEnd.matches('^([01]?[0-9]|2[0-3]):[0-5][0-9]$'))))&&(!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vehicleType','vehicleModel','vehiclePlate','providerAvailable','providerUpdatedAt'])||resource.data.role in ['driver','deliveryProvider','partner'])&&((!('providerAvailable' in request.resource.data)||request.resource.data.providerAvailable!=true)||(resource.data.providerVerified==true&&(!('accountSuspended' in request.resource.data)||request.resource.data.accountSuspended!=true||('suspendedUntil' in request.resource.data&&request.resource.data.suspendedUntil<=request.time))&&(!('suspendedUntil' in request.resource.data)||request.resource.data.suspendedUntil<=request.time)&&(!('providerDocumentsExpiry' in request.resource.data)||request.resource.data.providerDocumentsExpiry>request.time)&&(!('documentsExpiryAt' in request.resource.data)||request.resource.data.documentsExpiryAt>request.time)&&(resource.data.role=='partner'||(request.resource.data.vehicleType is string&&request.resource.data.vehicleType.size()>0&&request.resource.data.vehiclePlate is string&&request.resource.data.vehiclePlate.size()>0))))&&(
          request.resource.data.capabilities==resource.data.capabilities ||
          (!('capabilities' in resource.data)&&request.resource.data.capabilities is list&&request.resource.data.capabilities.hasOnly(defaultCaps(resource.data.role))&&request.resource.data.capabilities.size()==defaultCaps(resource.data.role).size())
        ))
        ||
        (hasCapability('manageUsers')&&!protectedUser(uid)&&request.resource.data.uid==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','roleSelected','capabilities','providerVerified','providerAvailable','vehicleType','vehicleModel','vehiclePlate','displayName','phone','companyName','taxId','notificationsEnabled','notificationPreferences','profileVisibility','privacyPersonalization','language','accountSuspended','suspendedUntil','suspensionReason','suspendedBy','updatedAt'])&&(request.resource.data.role==resource.data.role||hasCapability('manageRoles'))&&(request.resource.data.capabilities==resource.data.capabilities||(hasCapability('manageRoles')&&(owner()||request.resource.data.capabilities.hasOnly(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.capabilities)))));
      match /savedPlaces/{placeId}{allow read,create,update,delete:if self(uid);}
      match /savedItems/{itemId}{allow read:if self(uid);allow create,update:if self(uid)&&request.resource.data.type in ['post','event','service','place']&&request.resource.data.itemId is string&&request.resource.data.title is string&&request.resource.data.title.size()>0&&request.resource.data.title.size()<=180;allow delete:if self(uid);}
      // PASS136: private saved searches and accessibility/offline preferences.
      match /savedSearches/{searchId} {
        allow read: if self(uid);
        allow create: if self(uid)&&request.resource.data.ownerId==uid&&request.resource.data.query is string&&request.resource.data.query.size()<=200&&request.resource.data.filters is map&&request.resource.data.filters.size()<=30&&request.resource.data.alertOnChange is bool;
        allow update: if self(uid)&&request.resource.data.ownerId==uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['query','filters','alertOnChange','updatedAt']);
        allow delete: if self(uid);
      }
      match /platformPreferences/{preferenceId} {
        allow read: if self(uid);
        allow create, update: if self(uid)&&preferenceId=='accessibility'&&request.resource.data.keys().hasOnly(['textScale','highContrast','reduceMotion','screenReaderHints','updatedAt'])&&request.resource.data.textScale is number&&request.resource.data.textScale>=0.8&&request.resource.data.textScale<=2.0&&request.resource.data.highContrast is bool&&request.resource.data.reduceMotion is bool&&request.resource.data.screenReaderHints is bool;
        allow delete: if self(uid);
      }
      match /supportTickets/{ticketId} {
        allow read: if self(uid)||hasCapability('manageUsers')||hasCapability('moderateContent');
        allow create: if self(uid)&&request.resource.data.userId==uid&&request.resource.data.subject is string&&request.resource.data.subject.size()>=4&&request.resource.data.subject.size()<=140&&request.resource.data.details is string&&request.resource.data.details.size()>=4&&request.resource.data.details.size()<=4000&&request.resource.data.priority in ['low','normal','high','urgent']&&request.resource.data.status=='open';
        allow update: if (hasCapability('manageUsers')||hasCapability('moderateContent'))&&request.resource.data.userId==resource.data.userId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','priority','adminReply','assignedTo','updatedAt']);
        allow delete: if owner();
      }
      match /complaints/{complaintId}{allow read:if self(uid)||hasCapability('moderateContent');allow create:if self(uid)&&request.resource.data.userId==uid&&request.resource.data.complaintId==complaintId&&request.resource.data.category is string&&request.resource.data.category.size()>0&&request.resource.data.subject is string&&request.resource.data.subject.size()>=4&&request.resource.data.subject.size()<=140&&request.resource.data.details is string&&request.resource.data.details.size()>=4&&request.resource.data.details.size()<=1500&&request.resource.data.status=='open';allow update:if hasCapability('moderateContent')&&request.resource.data.userId==resource.data.userId&&request.resource.data.complaintId==resource.data.complaintId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminReply','updatedAt','resolvedBy','resolvedAt']);allow delete:if owner();}
      match /blockedUsers/{blockedUid}{allow read,create,delete:if self(uid);}
      match /followers/{followerUid}{allow read:if signedIn();allow create,delete:if signedIn()&&request.auth.uid==followerUid&&notBlocked(request.auth.uid,uid);}
      match /following/{followingUid}{allow read:if signedIn();allow create,delete:if self(uid)&&notBlocked(uid,followingUid);}
      match /notifications/{notificationId}{
        allow read:if self(uid)||hasCapability('manageNotifications');
        allow create:if signedIn()&&request.resource.data.recipientId==uid&&(
          (request.resource.data.type=='ride'&&request.resource.data.rideId is string&&exists(/databases/$(database)/documents/rides/$(request.resource.data.rideId))&&(
            hasCapability('manageNotifications')||
            (get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.clientId==request.auth.uid&&(request.resource.data.recipientId==get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.providerId||request.resource.data.recipientId==get(/databases/$(database)/documents/system/bootstrap).data.ownerUid))||
            (get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.providerId==request.auth.uid&&request.resource.data.recipientId==get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.clientId)
          ))
          ||
          (request.resource.data.type=='role_request'&&request.resource.data.roleRequestId is string&&exists(/databases/$(database)/documents/roleRequests/$(request.resource.data.roleRequestId))&&((get(/databases/$(database)/documents/roleRequests/$(request.resource.data.roleRequestId)).data.userId==request.auth.uid&&request.resource.data.recipientId==get(/databases/$(database)/documents/system/bootstrap).data.ownerUid)||(hasCapability('manageRoles')&&request.resource.data.recipientId==get(/databases/$(database)/documents/roleRequests/$(request.resource.data.roleRequestId)).data.userId)))
          ||
          (request.resource.data.type=='follow'&&request.resource.data.senderId==request.auth.uid&&request.resource.data.targetId==request.resource.data.recipientId&&exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId)/followers/$(request.auth.uid)))
          ||
          (request.resource.data.type=='social'&&request.resource.data.senderId==request.auth.uid&&request.resource.data.targetId is string&&exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId))&&get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.authorId==request.resource.data.recipientId&&((request.resource.data.action=='like'&&request.auth.uid in get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)).data.likes)||(request.resource.data.action=='comment'&&request.resource.data.sourceId is string&&exists(/databases/$(database)/documents/posts/$(request.resource.data.targetId)/comments/$(request.resource.data.sourceId))&&get(/databases/$(database)/documents/posts/$(request.resource.data.targetId)/comments/$(request.resource.data.sourceId)).data.authorId==request.auth.uid)||(request.resource.data.action=='repost'&&request.resource.data.sourceId is string&&exists(/databases/$(database)/documents/posts/$(request.resource.data.sourceId))&&get(/databases/$(database)/documents/posts/$(request.resource.data.sourceId)).data.authorId==request.auth.uid&&get(/databases/$(database)/documents/posts/$(request.resource.data.sourceId)).data.repostedFrom==request.resource.data.targetId)))
          ||
          (request.resource.data.type=='complaint_update'&&hasCapability('moderateContent')&&request.resource.data.action=='complaint_update'&&request.resource.data.targetId is string&&exists(/databases/$(database)/documents/users/$(uid)/complaints/$(request.resource.data.targetId))&&get(/databases/$(database)/documents/users/$(uid)/complaints/$(request.resource.data.targetId)).data.userId==uid)
          ||
          (request.resource.data.type=='provider_cancellation_review'&&request.resource.data.recipientId==get(/databases/$(database)/documents/system/bootstrap).data.ownerUid&&request.resource.data.targetId is string&&exists(/databases/$(database)/documents/rides/$(request.resource.data.targetId))&&get(/databases/$(database)/documents/rides/$(request.resource.data.targetId)).data.status=='cancelled'&&get(/databases/$(database)/documents/rides/$(request.resource.data.targetId)).data.cancelledBy==request.auth.uid)
          ||
          (request.resource.data.type=='chat'&&request.resource.data.senderId==request.auth.uid&&request.resource.data.conversationId is string&&exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))&&request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.members&&request.resource.data.recipientId in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.members)
          ||(request.resource.data.type=='pricing'&&hasCapability('manageNotifications')&&request.resource.data.title is string&&request.resource.data.message is string)
        );
        allow update,delete:if (self(uid)&&request.resource.data.recipientId==resource.data.recipientId&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','updatedAt']))||hasCapability('manageNotifications');
      }
    }

    match /roleRequests/{requestId}{
      allow create:if signedIn()&&request.resource.data.userId==request.auth.uid&&request.resource.data.status=='pending'&&request.resource.data.requestedRole in ['driver','deliveryProvider','partner']&&request.resource.data.applicantName is string&&request.resource.data.applicantName.size()>=3&&request.resource.data.phone is string&&request.resource.data.phone.size()>=8&&request.resource.data.documentPaths is map&&((request.resource.data.requestedRole=='partner'&&request.resource.data.documentPaths.keys().hasAll(['identity','companyRegistration'])&&request.resource.data.companyName is string&&request.resource.data.taxId is string)||(request.resource.data.requestedRole in ['driver','deliveryProvider']&&request.resource.data.documentPaths.keys().hasAll(['identity','license','vehicleRegistration','insurance'])&&request.resource.data.vehicleType is string&&request.resource.data.vehiclePlate is string));
      allow read:if signedIn()&&(resource.data.userId==request.auth.uid||hasCapability('manageRoles'));
      allow update:if hasCapability('manageRoles')&&resource.data.status=='pending'&&request.resource.data.status in ['approved','rejected']&&request.resource.data.userId==resource.data.userId&&request.resource.data.requestedRole==resource.data.requestedRole&&request.resource.data.reviewedBy==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','updatedAt']);
      allow delete:if owner();
    }

    match /rides/{rideId}{
      allow create:if signedIn()&&request.resource.data.clientId==request.auth.uid&&request.resource.data.status=='searching'&&request.resource.data.providerId==null&&request.resource.data.kind in ['taxiMoto','carExpress','deliveryMoto','deliveryVan','deliveryTruck','sos','ambulance','randonnee']&&request.resource.data.estimatedFare is number&&request.resource.data.estimatedFare>=0&&request.resource.data.distanceKm is number&&request.resource.data.distanceKm>=0&&request.resource.data.baseFare is number&&request.resource.data.ratePerKm is number&&request.resource.data.pricingPeriod in ['day','night']&&((request.resource.data.negotiable==true&&negotiableFor(request.resource.data.kind)&&request.resource.data.estimatedFare==0&&request.resource.data.baseFare==0&&request.resource.data.ratePerKm==0)|| (request.resource.data.negotiable==false&&!negotiableFor(request.resource.data.kind)&&request.resource.data.baseFare==baseFor(request.resource.data.kind)&&request.resource.data.ratePerKm==rateFor(request.resource.data.kind,request.resource.data.pricingPeriod)&&request.resource.data.estimatedFare>=request.resource.data.baseFare+request.resource.data.distanceKm*request.resource.data.ratePerKm&&request.resource.data.estimatedFare<=request.resource.data.baseFare+request.resource.data.distanceKm*request.resource.data.ratePerKm+0.01))&&request.resource.data.priority in ['normal','emergency','medical']&&((request.resource.data.kind=='sos'&&request.resource.data.priority=='emergency')||(request.resource.data.kind=='ambulance'&&request.resource.data.priority=='medical')||(request.resource.data.kind in ['taxiMoto','carExpress','deliveryMoto','deliveryVan']&&request.resource.data.priority=='normal')||(request.resource.data.kind=='deliveryTruck'&&request.resource.data.priority=='normal')||(request.resource.data.kind=='randonnee'&&request.resource.data.priority=='normal'))&&request.resource.data.pickup is string&&request.resource.data.pickup.size()>0&&request.resource.data.destination is string&&request.resource.data.destination.size()>0&&request.resource.data.distanceKm>0&&validLat(request.resource.data.pickupLat)&&validLng(request.resource.data.pickupLng)&&validLat(request.resource.data.destinationLat)&&validLng(request.resource.data.destinationLng)&&!(request.resource.data.pickupLat==0&&request.resource.data.pickupLng==0)&&!(request.resource.data.destinationLat==0&&request.resource.data.destinationLng==0)&&((request.resource.data.kind in ['deliveryMoto','deliveryVan','deliveryTruck']&&request.resource.data.delivery is map&&request.resource.data.delivery.recipientName is string&&request.resource.data.delivery.recipientName.size()>=2&&request.resource.data.delivery.recipientName.size()<=120&&request.resource.data.delivery.recipientPhone is string&&request.resource.data.delivery.recipientPhone.size()>=8&&request.resource.data.delivery.recipientPhone.size()<=24&&request.resource.data.delivery.parcelCategory is string&&request.resource.data.delivery.parcelCategory.size()>0&&request.resource.data.delivery.parcelCategory.size()<=80&&request.resource.data.delivery.parcelNotes is string&&request.resource.data.delivery.parcelNotes.size()<=500)||(request.resource.data.kind in ['taxiMoto','carExpress','sos','ambulance','randonnee']&&!('delivery' in request.resource.data)));
      allow read:if signedIn()&&(resource.data.clientId==request.auth.uid||resource.data.providerId==request.auth.uid||hasCapability('manageRides')||(provider()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.providerAvailable==true&&resource.data.status in ['searching','countered']&&canServe(resource.data.kind)));
      allow update:if signedIn() && (
